# Copy to deploy/.env and change every CHANGE_ME value before first start.
# Never commit deploy/.env (it is git-ignored).

# --- bootstrap administrator (created only if no users exist) ---
MALWARESCAN_ADMIN_USER=admin
MALWARESCAN_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# --- secrets: if unset, a random key is generated into the data volume ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
MALWARESCAN_SECRET_KEY=CHANGE_ME

# --- access policy ---
MALWARESCAN_CORS_ORIGINS=http://localhost:3000
MALWARESCAN_TOKEN_MINUTES=720
MALWARESCAN_LOGIN_MAX_FAILURES=5
MALWARESCAN_LOGIN_LOCKOUT_MINUTES=15
MALWARESCAN_RATE_LIMIT=600
MALWARESCAN_RATE_LIMIT_AUTH=20
MALWARESCAN_UPLOAD_MAX_BYTES=209715200

# --- monitoring cadence (seconds) and retention ---
MALWARESCAN_LOCAL_MONITORING=true
MALWARESCAN_PROCESS_INTERVAL=15
MALWARESCAN_NETWORK_INTERVAL=20
MALWARESCAN_FIM_INTERVAL=300
MALWARESCAN_INVENTORY_INTERVAL=3600
MALWARESCAN_LOG_RETENTION_DAYS=14
MALWARESCAN_FIM_PATHS=/etc,/usr/local/bin
MALWARESCAN_LOG_FILES=/var/log/auth.log,/var/log/syslog

# --- response safety (both default to the safe setting) ---
# Live firewall changes (block_ip) stay disabled unless this is true AND the host
# runs the API with the necessary privileges. Dry-run is always available.
MALWARESCAN_RESPONSE_ALLOW_DANGEROUS=false
MALWARESCAN_RESPONSE_CONFIRM=true

# --- OPTIONAL integrations (unset = off; the UI reports them as "not configured") ---
MALWARESCAN_NVD_ENABLED=false
MALWARESCAN_NVD_API_KEY=
MALWARESCAN_THREAT_FEED_URLS=
MALWARESCAN_RULES_URL=
MALWARESCAN_SANDBOX_URL=
MALWARESCAN_SANDBOX_KEY=
MALWARESCAN_LLM_URL=
MALWARESCAN_LLM_KEY=
MALWARESCAN_SMTP_ENABLED=false
